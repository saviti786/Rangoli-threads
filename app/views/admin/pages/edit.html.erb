<div class="container my-5">
  <div class="row">
    <div class="col-lg-10 mx-auto">
      <h1 class="mb-4">Edit <%= @page.title %></h1>

      <%= form_with(model: [:admin, @page], local: true) do |f| %>
        <% if @page.errors.any? %>
          <div class="alert alert-danger">
            <h4><%= pluralize(@page.errors.count, "error") %> prohibited this page from being saved:</h4>
            <ul>
              <% @page.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :title, class: "form-label" %>
          <%= f.text_field :title, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :content, class: "form-label" %>
          <%= f.text_area :content, rows: 15, class: "form-control" %>
          <small class="form-text text-muted">
            You can use simple formatting. Line breaks will be preserved.
          </small>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit "Update Page", class: "btn btn-primary" %>
          <%= link_to "View Page", page_path(@page.slug), class: "btn btn-secondary", target: "_blank" %>
          <%= link_to "Cancel", admin_root_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>