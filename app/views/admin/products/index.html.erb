<h1>Products Management</h1>
<%= link_to "Products", admin_products_path, class: "nav-link" %>
<%= link_to "Categories", admin_categories_path, class: "nav-link" %>
<%= link_to 'New Product', new_admin_product_path, class: 'btn btn-primary' %>

<table class="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Price</th>
      <th>Stock</th>
      <th>Category</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= number_to_currency(product.price) %></td>
        <td><%= product.stock %></td>
        <td><%= product.category&.name %></td>
        <td>
          <%= link_to 'Edit', edit_admin_product_path(product) %>
          <%= link_to "Delete", admin_product_path(product),
          data: {
            turbo_method: :delete,
            turbo_confirm: "Are you sure you want to delete '#{product.name}'?"
          },
          class: "btn btn-danger btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>