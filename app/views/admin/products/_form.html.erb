<%# app/views/admin/products/_form.html.erb %>
<%= form_with(model: [:admin, @product], local: true) do |f| %>
  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :description %>
    <%= f.text_area :description, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :price %>
    <%= f.number_field :price, step: 0.01, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :stock %>
    <%= f.number_field :stock, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :category_id %>
    <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Select a category" }, class: "form-control" %>
  </div>

  <div class="field">
    <%= f.label :image %>
    <%= f.file_field :image, class: "form-control" %>
    <% if @product.image.attached? %>
      <%= image_tag @product.image, width: 100 %>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :on_sale %>
    <%= f.check_box :on_sale %>
  </div>

  <div class="field">
    <%= f.label :new_arrival %>
    <%= f.check_box :new_arrival %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>