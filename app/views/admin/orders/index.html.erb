<div class="row mb-4">
  <div class="col-12">
    <h2 class="fw-bold">All Orders</h2>
    <p class="text-muted">Manage customer orders</p>
  </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card bg-primary text-white">
      <div class="card-body">
        <h6 class="mb-1">Total Orders</h6>
        <h3 class="mb-0"><%= Order.count %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card bg-warning text-dark">
      <div class="card-body">
        <h6 class="mb-1">Pending</h6>
        <h3 class="mb-0"><%= Order.where(status: 'pending').count %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card bg-success text-white">
      <div class="card-body">
        <h6 class="mb-1">Completed</h6>
        <h3 class="mb-0"><%= Order.where(status: 'paid').count %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card bg-info text-white">
      <div class="card-body">
        <h6 class="mb-1">Total Revenue</h6>
        <h3 class="mb-0">$<%= number_with_precision(Order.sum(:total_amount), precision: 2) %></h3>
      </div>
    </div>
  </div>
</div>

<!-- Orders Table -->
<div class="card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Order #</th>
            <th>Customer</th>
            <th>Date</th>
            <th>Items</th>
            <th>Subtotal</th>
            <th>Taxes</th>
            <th>Total</th>
            <th>Status</th>
          </tr>
        </thead>

        <tbody>
          <% @orders.each do |order| %>
            <%
              subtotal = order.order_items.sum { |item| item.purchase_price * item.quantity }
              gst = (subtotal * order.gst_rate / 100).round(2)
              pst = (subtotal * order.pst_rate / 100).round(2)
              hst = (subtotal * order.hst_rate / 100).round(2)
              total_tax = gst + pst + hst
            %>

            <tr>
              <td><strong>#<%= order.id %></strong></td>

              <td>
                <strong><%= order.user.name || order.user.email %></strong><br>
                <small class="text-muted"><%= order.user.email %></small>
              </td>

              <td><%= order.created_at.strftime("%b %d, %Y") %></td>

              <td>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-bs-toggle="modal"
                        data-bs-target="#orderModal<%= order.id %>">
                    <%= pluralize(order.order_items.count, "item") %>
                </button>
              </td>

              <td>$<%= number_with_precision(subtotal, precision: 2) %></td>

              <td>
                <small class="text-muted">
                <% if gst > 0 %> GST: $<%= number_with_precision(gst,precision: 2) %><br> <% end %>
                <% if pst > 0 %> PST: $<%= number_with_precision(pst,precision: 2) %><br> <% end %>
                <% if hst > 0 %> HST: $<%= number_with_precision(hst,precision: 2) %> <% end %>
                </small>
              </td>

              <td class="fw-bold text-primary">$<%= number_with_precision(order.total_amount,precision: 2) %></td>

              <td>
                <span class="badge bg-<%= order.status == 'pending' ? 'warning' : 'success' %>">
                  <%= order.status.titleize %>
                </span>
              </td>

            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-3">
      <%= paginate @orders %>
    </div>
  </div>
</div>

<!-- =============== -->
<!-- MODALS GO HERE  -->
<!-- =============== -->
<% @orders.each do |order| %>
  <%
    subtotal = order.order_items.sum { |item| item.purchase_price * item.quantity }
    gst = (subtotal * order.gst_rate / 100).round(2)
    pst = (subtotal * order.pst_rate / 100).round(2)
    hst = (subtotal * order.hst_rate / 100).round(2)
  %>

  <div class="modal fade" id="orderModal<%= order.id %>" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">

        <div class="modal-header">
          <h5 class="modal-title">Order #<%= order.id %> - Items</h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Price</th>
                  <th>Qty</th>
                  <th>Subtotal</th>
                </tr>
              </thead>

              <tbody>
                <% order.order_items.each do |item| %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center">
                        <% if item.product.image.attached? %>
                          <%= image_tag item.product.image, class: "rounded me-2", style: "width: 40px; height: 40px; object-fit: cover;" %>
                        <% end %>

                        <div>
                          <strong><%= item.product.name %></strong><br>
                          <small class="text-muted"><%= item.product.category.name %></small>
                        </div>
                      </div>
                    </td>

                    <td>$<%= number_with_precision(item.purchase_price,precision: 2) %></td>
                    <td><%= item.quantity %></td>
                    <td>$<%= number_with_precision(item.quantity * item.purchase_price,precision: 2) %></td>
                  </tr>
                <% end %>
              </tbody>

              <tfoot class="table-light">
                <tr>
                  <td colspan="3" class="text-end"><strong>Subtotal:</strong></td>
                  <td><strong>$<%= number_with_precision(subtotal, precision:2) %></strong></td>
                </tr>

                <% if gst > 0 %>
                  <tr><td colspan="3" class="text-end">GST (<%= order.gst_rate %>%)</td><td>$<%= gst %></td></tr>
                <% end %>

                <% if pst > 0 %>
                  <tr><td colspan="3" class="text-end">PST (<%= order.pst_rate %>%)</td><td>$<%= pst %></td></tr>
                <% end %>

                <% if hst > 0 %>
                  <tr><td colspan="3" class="text-end">HST (<%= order.hst_rate %>%)</td><td>$<%= hst %></td></tr>
                <% end %>

                <tr class="table-primary">
                  <td colspan="3" class="text-end"><strong>Grand Total:</strong></td>
                  <td><strong class="text-primary">$<%= number_with_precision(order.total_amount,precision: 2) %></strong></td>
                </tr>
              </tfoot>
            </table>
          </div>

          <h6 class="mt-3">Customer Information</h6>
          <p><strong>Name:</strong> <%= order.user&.name || "N/A" %></p>
          <p><strong>Email:</strong> <%= order.user&.email || "N/A" %></p>

          <p><strong>Address:</strong>
            <%= order.user&.street || "N/A" %>,
            <%= order.user&.city || "N/A" %>,
            <%= order.user&.province&.name || "N/A" %>
            <%= order.user&.postal_code || "" %>
          </p>

        </div>
      </div>
    </div>
  </div>
<% end %>
