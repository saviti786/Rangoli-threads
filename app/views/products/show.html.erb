<div class="container my-5">
  <!-- Breadcrumbs -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
      <li class="breadcrumb-item"><%= link_to "Products", products_path %></li>
      <li class="breadcrumb-item"><%= link_to @product.category.name, category_path(@product.category) %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= @product.name %></li>
    </ol>
  </nav>

  <div class="row">
    <!-- Product Image -->
    <div class="col-md-6 mb-4">
      <div class="card">
        <% if @product.image.attached? %>
          <%= image_tag @product.image, class: "card-img-top", alt: @product.name %>
        <% else %>
          <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 500px;">
            <span class="text-muted fs-4">No Image Available</span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Product Details -->
    <div class="col-md-6">
      <h1 class="mb-3"><%= @product.name %></h1>

      <!-- Category -->
      <p class="text-muted mb-3">
        <strong>Category:</strong>
        <%= link_to @product.category.name, category_path(@product.category), class: "text-decoration-none" %>
      </p>

      <!-- Badges -->
      <div class="mb-3">
        <% if @product.on_sale %>
          <span class="badge bg-success fs-6 me-2">On Sale!</span>
        <% end %>
        <% if @product.new_arrival %>
          <span class="badge bg-info text-dark fs-6 me-2">New Arrival</span>
        <% end %>
        <% if @product.updated_at > 3.days.ago && @product.created_at < 3.days.ago %>
          <span class="badge bg-warning text-dark fs-6">Recently Updated</span>
        <% end %>
      </div>

      <!-- Price -->
      <div class="mb-4">
        <h2 class="text-primary">
          $<%= number_with_precision(@product.price, precision: 2) %>
        </h2>
      </div>

      <!-- Stock Status -->
      <div class="mb-4">
        <% if @product.stock > 0 %>
          <span class="badge bg-success fs-6">In Stock (<%= @product.stock %> available)</span>
        <% else %>
          <span class="badge bg-danger fs-6">Out of Stock</span>
        <% end %>
      </div>

      <!-- Description -->
      <div class="mb-4">
        <h4>Description</h4>
        <p><%= simple_format(@product.description) %></p>
      </div>

      <!-- Add to Cart Form -->
      <% if @product.stock > 0 %>
        <%= form_with url: add_to_cart_path(@product.id), method: :post, local: true do |f| %>
          <div class="mb-3">
            <label for="quantity" class="form-label fw-semibold">Quantity:</label>
            <div class="input-group" style="max-width: 200px;">
              <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('quantity').stepDown()">
                <i class="bi bi-dash"></i>
              </button>
              <%= f.number_field :quantity,
                  id: 'quantity',
                  value: 1,
                  min: 1,
                  max: @product.stock,
                  class: "form-control text-center" %>
              <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('quantity').stepUp()">
                <i class="bi bi-plus"></i>
              </button>
            </div>
          </div>

            <%= f.submit "Add to Cart", class: "btn btn-primary btn-lg w-100 mb-3" do %>
              <i class="bi bi-cart-plus"></i> Add to Cart
            <% end %>
          <% end %>
        <% else %>
          <button class="btn btn-secondary btn-lg w-100 mb-3" disabled>
            Out of Stock
          </button>
        <% end %>

      <!-- Admin Edit Link -->
      <% if current_user&.admin? %>
        <div class="mt-3">
          <%= link_to "Edit Product", edit_admin_product_path(@product), class: "btn btn-warning" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Related Products -->
  <% if @related_products.any? %>
    <div class="row mt-5">
      <div class="col-12">
        <h3 class="mb-4">Related Products from <%= @product.category.name %></h3>
      </div>

      <% @related_products.each do |related| %>
        <div class="col-md-3 mb-4">
          <div class="card h-100">
            <% if related.image.attached? %>
              <%= link_to product_path(related) do %>
                <%= image_tag related.image, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
              <% end %>
            <% else %>
              <%= link_to product_path(related) do %>
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                  <span class="text-muted">No Image</span>
                </div>
              <% end %>
            <% end %>

            <div class="card-body">
              <h5 class="card-title">
                <%= link_to related.name, product_path(related), class: "text-decoration-none" %>
              </h5>
              <p class="card-text">
                <strong class="text-primary">$<%= number_with_precision(related.price, precision: 2) %></strong>
              </p>
              <%= link_to "View Details", product_path(related), class: "btn btn-sm btn-outline-primary" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>