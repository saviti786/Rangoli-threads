<div class="container-fluid px-0">
  <!-- Hero Search Section -->
  <div class="search-section">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 mx-auto text-center mb-4">
          <h1 class="display-4 fw-bold mb-3">
            <%= @filter_title || "Discover Authentic Indian Fashion" %>
          </h1>
          <p class="lead">Browse our curated collection of traditional and contemporary ethnic wear</p>
        </div>
      </div>

      <!-- Search Form -->
      <div class="row">
        <div class="col-lg-8 mx-auto">
          <%= form_with url: search_products_path, method: :get, local: true do |f| %>
            <div class="input-group input-group-lg shadow">
              <%= f.text_field :query,
                  value: params[:query],
                  placeholder: "Search for sarees, kurtas, lehengas...",
                  class: "form-control" %>

              <%= f.select :category_id,
                  options_for_select(
                    [["All Categories", ""]] + @categories.map { |c| [c.name, c.id] },
                    params[:category_id]
                  ),
                  {},
                  class: "form-select" %>

              <%= f.submit "Search", class: "btn btn-primary px-4" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container my-5">
  <!-- Filter Pills -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="fw-bold me-2">Quick Filters:</span>
        <%= link_to products_path, class: "btn btn-outline-dark #{current_page?(products_path) ? 'active' : ''}" do %>
          <i class="bi bi-grid-3x3-gap"></i> All Products
        <% end %>
        <%= link_to on_sale_products_path, class: "btn btn-outline-success #{current_page?(on_sale_products_path) ? 'active' : ''}" do %>
          <i class="bi bi-percent"></i> On Sale
        <% end %>
        <%= link_to new_arrivals_products_path, class: "btn btn-outline-info #{current_page?(new_arrivals_products_path) ? 'active' : ''}" do %>
          <i class="bi bi-star-fill"></i> New Arrivals
        <% end %>
        <%= link_to recently_updated_products_path, class: "btn btn-outline-warning #{current_page?(recently_updated_products_path) ? 'active' : ''}" do %>
          <i class="bi bi-arrow-clockwise"></i> Recently Updated
        <% end %>
      </div>
    </div>
  </div>

  <!-- Category Pills -->
  <div class="row mb-4">
    <div class="col-12">
      <h5 class="mb-3"><i class="bi bi-tags-fill"></i> Shop by Category:</h5>
      <div class="d-flex flex-wrap">
        <% @categories.each do |category| %>
          <%= link_to category.name, category_path(category), class: "category-pill" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Results Count -->
  <div class="row mb-3">
    <div class="col-12">
      <p class="text-muted">
        <i class="bi bi-check-circle-fill text-success"></i>
        Showing <%= @products.count %> of <%= @products.total_count %> products
      </p>
    </div>
  </div>

  <!-- Products Grid -->
  <div class="row g-4">
    <% if @products.any? %>
      <% @products.each do |product| %>
        <div class="col-sm-6 col-md-4 col-lg-3">
          <div class="card h-100">
            <!-- Product Image -->
            <%= link_to product_path(product), class: "text-decoration-none" do %>
              <% if product.image.attached? %>
                <%= image_tag product.image, class: "card-img-top", alt: product.name %>
              <% else %>
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center">
                  <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
                </div>
              <% end %>
            <% end %>

            <!-- Product Body -->
            <div class="card-body d-flex flex-column">
              <!-- Category Badge -->
              <p class="card-text mb-2">
                <small class="text-muted">
                  <i class="bi bi-tag"></i> <%= product.category.name %>
                </small>
              </p>

              <!-- Product Name -->
              <h5 class="card-title">
                <%= link_to product.name, product_path(product), class: "text-dark text-decoration-none" %>
              </h5>

              <!-- Description -->
              <p class="card-text text-muted small flex-grow-1">
                <%= truncate(product.description, length: 80) %>
              </p>

              <!-- Badges -->
              <div class="mb-2">
                <% if product.on_sale %>
                  <span class="badge bg-success"><i class="bi bi-percent"></i> Sale</span>
                <% end %>
                <% if product.new_arrival %>
                  <span class="badge bg-info text-dark"><i class="bi bi-star-fill"></i> New</span>
                <% end %>
                <% if product.updated_at > 3.days.ago && product.created_at < 3.days.ago %>
                  <span class="badge bg-warning text-dark"><i class="bi bi-arrow-clockwise"></i> Updated</span>
                <% end %>
              </div>

              <!-- Price and Button -->
              <div class="mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h4 class="mb-0 text-primary fw-bold">
                    $<%= number_with_precision(product.price, precision: 2) %>
                  </h4>
                  <% if product.stock > 0 %>
                    <small class="text-success"><i class="bi bi-check-circle-fill"></i> In Stock</small>
                  <% else %>
                    <small class="text-danger"><i class="bi bi-x-circle-fill"></i> Out of Stock</small>
                  <% end %>
                </div>

                <%= link_to product_path(product), class: "btn btn-primary w-100" do %>
                  <i class="bi bi-eye"></i> View Details
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <!-- No Products Found -->
      <div class="col-12">
        <div class="alert alert-info text-center py-5">
          <i class="bi bi-search fs-1 d-block mb-3"></i>
          <h4>No products found</h4>
          <p class="mb-3">We couldn't find any products matching your criteria.</p>
          <%= link_to "View All Products", products_path, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <div class="row mt-5">
    <div class="col-12 d-flex justify-content-center">
      <%= paginate @products %>
    </div>
  </div>
</div>