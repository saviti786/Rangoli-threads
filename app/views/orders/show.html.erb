<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Success Message -->
      <div class="alert alert-success text-center mb-4">
        <i class="bi bi-check-circle-fill fs-1"></i>
        <h4 class="mt-3">Order Placed Successfully!</h4>
        <p class="mb-0">Thank you for your order.</p>
      </div>

      <!-- Invoice Card -->
      <div class="card shadow">
        <div class="card-header bg-dark text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">Invoice</h4>
              <small>Order #<%= @order.id %></small>
            </div>
            <div class="text-end">
              <strong>Rangoli Threads</strong><br>
              <small>Pembina Highway, Winnipeg, MB</small>
            </div>
          </div>
        </div>

        <div class="card-body">
          <!-- Order Info -->
          <div class="row mb-4">
            <div class="col-md-6">
              <h6 class="text-muted mb-2">ORDER DETAILS</h6>
              <p class="mb-1"><strong>Order Date:</strong> <%= @order.created_at.strftime("%B %d, %Y") %></p>
              <p class="mb-1"><strong>Order #:</strong> <%= @order.id %></p>
              <p class="mb-1">
                <strong>Status:</strong>
                <span class="badge bg-<%= @order.status == 'pending' ? 'warning' : 'success' %>">
                  <%= @order.status.titleize %>
                </span>
              </p>
            </div>
          </div>

            <div class="col-md-6">
              <h6 class="text-muted mb-2">USER DETAILS</h6>
              <p class="mb-1"><strong><%= @order.user&.name.presence || @order.user&.email %></strong></p>
              <p class="mb-1">Province: <%= @order.province_name %>
            </div>

          <!-- Order Items -->
          <h6 class="text-muted mb-3">ORDER ITEMS</h6>
          <div class="table-responsive mb-4">
            <table class="table">
              <thead class="table-light">
                <tr>
                  <th>Product</th>
                  <th>Price</th>
                  <th>Quantity</th>
                  <th class="text-end">Subtotal</th>
                </tr>
              </thead>
              <tbody>
                <% subtotal = 0 %>
                <% @order.order_items.each do |item| %>
                  <% item_subtotal = item.purchase_price * item.quantity %>
                  <% subtotal += item_subtotal %>
                  <tr>
                    <td>
                      <strong><%= item.product.name %></strong><br>
                      <small class="text-muted"><%= item.product.category.name %></small>
                    </td>
                    <td>$<%= number_with_precision(item.purchase_price, precision: 2) %></td>
                    <td><%= item.quantity %></td>
                    <td class="text-end">$<%= number_with_precision(item_subtotal, precision: 2) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <!-- Totals -->
          <div class="row">
            <div class="col-md-6 ms-auto">
              <table class="table">
                <tr>
                  <td><strong>Subtotal:</strong></td>
                  <td class="text-end">$<%= number_with_precision(subtotal, precision: 2) %></td>
                </tr>

                <% if @order.gst_rate > 0 %>
                  <tr>
                    <td>GST (<%= @order.gst_rate %>%):</td>
                    <td class="text-end">$<%= number_with_precision(subtotal * @order.gst_rate / 100, precision: 2) %></td>
                  </tr>
                <% end %>

                <% if @order.pst_rate > 0 %>
                  <tr>
                    <td>PST (<%= @order.pst_rate %>%):</td>
                    <td class="text-end">$<%= number_with_precision(subtotal * @order.pst_rate / 100, precision: 2) %></td>
                  </tr>
                <% end %>

                <% if @order.hst_rate > 0 %>
                  <tr>
                    <td>HST (<%= @order.hst_rate %>%):</td>
                    <td class="text-end">$<%= number_with_precision(subtotal * @order.hst_rate / 100, precision: 2) %></td>
                  </tr>
                <% end %>

                <tr class="table-dark">
                  <td><strong>Total:</strong></td>
                  <td class="text-end"><strong class="text-primary fs-5">$<%= number_with_precision(@order.total_amount, precision: 2) %></strong></td>
                </tr>
              </table>
            </div>
          </div>
        </div>

        <div class="card-footer bg-light">
          <div class="d-flex justify-content-between align-items-center">
            <%= link_to "Continue Shopping", products_path, class: "btn btn-primary" %>
          </div>
        </div>
      </div>

      <!-- Order History Link -->
      <div class="text-center mt-4">
        <%= link_to orders_path, class: "text-muted" do %>
          <i class="bi bi-clock-history"></i> View All Orders
        <% end %>
      </div>
    </div>
  </div>
</div>