<div class="container my-5">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="fw-bold">
        <i class="bi bi-cart"></i> Shopping Cart
      </h1>
      <p class="text-muted">Review your items before checkout</p>
    </div>
  </div>

  <% if @cart_items.any? %>
    <div class="row">
      <!-- Cart Items -->
      <div class="col-lg-8">
        <div class="card mb-4">
          <div class="card-body">
            <% @cart_items.each do |item| %>
              <div class="row align-items-center border-bottom py-3">
                <!-- Product Image -->
                <div class="col-md-2">
                  <%= link_to product_path(item[:product]) do %>
                    <% if item[:product].image.attached? %>
                      <%= image_tag item[:product].image, class: "img-fluid rounded", alt: item[:product].name %>
                    <% else %>
                      <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 100px;">
                        <i class="bi bi-image text-muted fs-2"></i>
                      </div>
                    <% end %>
                  <% end %>
                </div>

                <!-- Product Info -->
                <div class="col-md-4">
                  <h5 class="mb-1">
                    <%= link_to item[:product].name, product_path(item[:product]), class: "text-dark text-decoration-none" %>
                  </h5>
                  <p class="text-muted small mb-1">
                    <i class="bi bi-tag"></i> <%= item[:product].category.name %>
                  </p>
                  <p class="text-primary fw-bold mb-0">
                    $<%= number_with_precision(item[:product].price, precision: 2) %>
                  </p>
                </div>

                <!-- Quantity Controls -->
                <div class="col-md-3">
                  <%= form_with url: update_cart_item_path(item[:product].id), method: :patch, local: true, class: "d-flex align-items-center" do |f| %>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="this.nextElementSibling.stepDown(); this.form.requestSubmit();">
                      <i class="bi bi-dash"></i>
                    </button>

                    <%= f.number_field :quantity,
                        value: item[:quantity],
                        min: 0,
                        max: item[:product].stock,
                        class: "form-control form-control-sm text-center mx-2",
                        style: "width: 60px;",
                        onchange: "this.form.requestSubmit();" %>

                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="this.previousElementSibling.stepUp(); this.form.requestSubmit();">
                      <i class="bi bi-plus"></i>
                    </button>
                  <% end %>

                  <small class="text-muted d-block mt-1">
                    Max: <%= item[:product].stock %>
                  </small>
                </div>

                <!-- Subtotal -->
                <div class="col-md-2 text-end">
                  <h5 class="fw-bold text-primary mb-2">
                    $<%= number_with_precision(item[:subtotal], precision: 2) %>
                  </h5>
                  <%= button_to remove_from_cart_path(item[:product].id),
                      method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      form: { data: { turbo_confirm: "Remove this item from cart?" } } do %>
                    <i class="bi bi-trash"></i> Remove
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Clear Cart Button -->
            <div class="mt-3 text-end">
              <%= button_to clear_cart_path,
                  method: :delete,
                  class: "btn btn-outline-danger",
                  form: { data: { turbo_confirm: "Are you sure you want to clear your cart?" } } do %>
                <i class="bi bi-x-circle"></i> Clear Cart
              <% end %>
            </div>
          </div>
        </div>

        <!-- Continue Shopping -->
        <div class="text-center">
          <%= link_to products_path, class: "btn btn-outline-primary" do %>
            <i class="bi bi-arrow-left"></i> Continue Shopping
          <% end %>
        </div>
      </div>

      <!-- Order Summary -->
      <div class="col-lg-4">
        <div class="card sticky-top" style="top: 20px;">
          <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-receipt"></i> Order Summary</h5>
          </div>
          <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
              <span>Subtotal (<%= pluralize(cart_count, 'item') %>):</span>
              <span class="fw-bold">$<%= number_with_precision(@cart_total, precision: 2) %></span>
            </div>

            <div class="d-flex justify-content-between mb-2 text-muted">
              <span>Shipping:</span>
              <span>Calculated at checkout</span>
            </div>

            <div class="d-flex justify-content-between mb-2 text-muted">
              <span>Tax:</span>
              <span>Calculated at checkout</span>
            </div>

            <hr>

            <div class="d-flex justify-content-between mb-4">
              <strong>Total:</strong>
              <h4 class="text-primary fw-bold mb-0">
                $<%= number_with_precision(@cart_total, precision: 2) %>
              </h4>
            </div>

            <div class="d-grid gap-2">
              <button class="btn btn-primary btn-lg" disabled>
                <i class="bi bi-lock"></i> Proceed to Checkout
              </button>
              <small class="text-muted text-center">
                (Checkout coming soon)
              </small>
            </div>
          </div>

          <div class="card-footer bg-light">
            <div class="d-flex align-items-center text-muted small">
              <i class="bi bi-shield-check me-2 fs-5"></i>
              <span>Secure checkout guaranteed</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Empty Cart -->
    <div class="row">
      <div class="col-12">
        <div class="card text-center py-5">
          <div class="card-body">
            <i class="bi bi-cart-x display-1 text-muted mb-4"></i>
            <h3>Your cart is empty</h3>
            <p class="text-muted mb-4">Add some items to get started!</p>
            <%= link_to products_path, class: "btn btn-primary btn-lg" do %>
              <i class="bi bi-grid-3x3-gap"></i> Browse Products
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>