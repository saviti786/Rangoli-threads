<div class="devise-links">
  <%- if controller_name != 'sessions' %>
    <p class="mb-2">
      Already have an account?
      <%= link_to "Log in", new_session_path(resource_name), class: "text-primary fw-semibold text-decoration-none" %>
    </p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p class="mb-2">
      Don't have an account?
      <%= link_to "Sign up", new_registration_path(resource_name), class: "text-primary fw-semibold text-decoration-none" %>
    </p>
  <% end %>

  <!-- Remove or comment out the forgot password link -->
  <%# if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%#= link_to "Forgot your password?", new_password_path(resource_name), class: "text-muted text-decoration-none" %>
  <%# end %>
</div>