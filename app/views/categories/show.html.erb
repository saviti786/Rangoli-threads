<div class="container my-5">
  <!-- Breadcrumbs -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
      <li class="breadcrumb-item"><%= link_to "Products", products_path %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= @category.name %></li>
    </ol>
  </nav>

  <div class="row mb-4">
    <div class="col-12">
      <h1><%= @category.name %></h1>
      <p class="lead text-muted"><%= pluralize(@products.total_count, 'product') %> found</p>
    </div>
  </div>

  <!-- Category Navigation -->
  <div class="row mb-4">
    <div class="col-12">
      <h5>Other Categories:</h5>
      <div class="d-flex gap-2 flex-wrap">
        <%= link_to "All Products", products_path, class: "btn btn-outline-secondary" %>
        <% @categories.each do |category| %>
          <%= link_to category.name,
              category_path(category),
              class: "btn #{category == @category ? 'btn-primary' : 'btn-outline-secondary'}" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Products Grid -->
  <div class="row">
    <% if @products.any? %>
      <% @products.each do |product| %>
        <div class="col-md-4 col-lg-3 mb-4">
          <div class="card h-100">
            <% if product.image.attached? %>
              <%= link_to product_path(product) do %>
                <%= image_tag product.image, class: "card-img-top", style: "height: 250px; object-fit: cover;" %>
              <% end %>
            <% else %>
              <%= link_to product_path(product) do %>
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                  <span class="text-muted">No Image</span>
                </div>
              <% end %>
            <% end %>

            <div class="card-body d-flex flex-column">
              <h5 class="card-title">
                <%= link_to product.name, product_path(product), class: "text-decoration-none" %>
              </h5>

              <p class="card-text flex-grow-1">
                <%= truncate(product.description, length: 80) %>
              </p>

              <div class="mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h4 class="mb-0 text-primary">
                    $<%= number_with_precision(product.price, precision: 2) %>
                  </h4>
                  <% if product.on_sale %>
                    <span class="badge bg-success">On Sale</span>
                  <% end %>
                </div>

                <%= link_to "View Details", product_path(product), class: "btn btn-primary btn-sm w-100" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-12">
        <div class="alert alert-info">
          No products in this category yet.
        </div>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <div class="row mt-4">
    <div class="col-12 d-flex justify-content-center">
      <%= paginate @products %>
    </div>
  </div>
</div>